# ── Toolbox ────────────────────────────────────────────────────
TOOLBOX_NAME     := qp-toolbox
TOOLBOX_IMAGE    := qp-toolbox:latest

# --- OpenSSL ----------------------------------------------------
OPENSSL_VER  := openssl-3.6.2
OPENSSL_REPO := https://github.com/openssl/openssl.git

# --- liboqs -----------------------------------------------------
LIBOQS_VER   := 0.15.0
OPENSSH_REPO := https://github.com/open-quantum-safe/openssh.git
LIBOQS_REPO  := https://github.com/open-quantum-safe/liboqs.git
QP_PORT      := 1716
BUILD_DIR    := .build

# --- Quantum Portal ---------------------------------------------
QP_PREFIX         := /usr/local/qp
QP_PROGRAM_PREFIX := qp-

# --- qp-stunnel (PQ-TLS terminator; links qp-ssh's bundled OpenSSL) ----------
STUNNEL_VER     := 5.78
STUNNEL_REPO    := https://github.com/mtrojnar/stunnel.git
QP_STUNNEL_PORT := 9443

# --- qp-nebula (PQ Noise mesh VPN; ML-KEM-1024 Noise_IX-analog handshake) -----
# Forked from upstream master (engine-abstracted handshake) and imported as the
# qp-nebula/nebula submodule (fork & edit). The exact fork commit is pinned by the
# submodule gitlink; NEBULA_VER documents the upstream base.
NEBULA_VER      := master-b041f30
NEBULA_REPO     := https://github.com/slackhq/nebula
QP_NEBULA_PORT  := 4242
# Source ISO for the libvirt sim's golden base image (build-base.sh). Stage your Fedora
# Server DVD in the image dir and point here; override per-run with QPN_FEDORA_ISO=...
QPN_FEDORA_ISO  := /var/lib/libvirt/images/qp-nebula/Fedora-Server-dvd-x86_64-44-1.7.iso

# ── Release / RPM publish ──────────────────────────────
QP_VERSION             := 1.0.0
RPM_UPLOAD_URL         := https://your-rpm.com/path/to/rpm/upload/api
RPM_REGISTRY_URL       := https://your-rpm.com/path/to/rpm/registry/api
PACKAGE_LINK_REPO      := your-linked-package
CA_CERT                := $(CURDIR)/certs/your-ca.pem

# RPM GPG signing
GPG_SIGN_KEY     := $(CURDIR)/certs/packaging.key
GPG_SIGN_CERT    := $(CURDIR)/certs/packaging.crt
GPG_SIGN_NAME    := we@omne.earth
RPM_REPO_KEY_URL := https://your-rpm.com/path/to/rpm/repository.key
