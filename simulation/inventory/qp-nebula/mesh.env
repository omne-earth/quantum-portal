# mesh - 2 lighthouses + 3 nodes = five VMs. n1,n2 dual-home across both lighthouses;
# n3 is single-homed on lh1 (so lighthouse failover has something to prove). Nodes
# discover each other through the lighthouses and pqIX-handshake on demand.
NODES=( "lh1:lighthouse" "lh2:lighthouse" "n1:node" "n2:node" "n3:node" )
declare -A LH_SET=( [n1]="lh1 lh2" [n2]="lh1 lh2" [n3]="lh1" [lh1]="lh2" [lh2]="lh1" )
PORT=4242
OVL_PREFIX="10.99.0."
