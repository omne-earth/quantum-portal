# relay - 1 lighthouse/relay + 2 nodes (three VMs). Both nodes home on lh1, which is
# also the relay; run-relay.sh blocks direct node-to-node underlay UDP so n1<->n2 must
# go through the relay.
NODES=( "lh1:lighthouse" "n1:node" "n2:node" )
declare -A LH_SET=( [n1]="lh1" [n2]="lh1" )
PORT=4242
OVL_PREFIX="10.99.0."
