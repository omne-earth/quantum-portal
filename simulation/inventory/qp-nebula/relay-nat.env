# relay-nat - REAL symmetric double-NAT relay. lh1 (relay) sits on the public segment
# (pub); n1 is behind nat1, n2 behind nat2 - each its own NAT. Both reach
# the relay, but neither can reach the other directly (separate NATs, no inbound
# mapping; --random-fully makes the source-port mapping symmetric), so n1<->n2 MUST
# relay through lh1. The nft direct-block is also applied as defense in depth.
NODES=( "lh1:lighthouse" "n1:node" "n2:node" )
declare -A LH_SET=( [n1]="lh1" [n2]="lh1" )
declare -A NET=( [lh1]="pub" [n1]="nat1" [n2]="nat2" )
NAT_CIDRS=( "192.168.161.0/24" "192.168.162.0/24" )
PORT=4242
OVL_PREFIX="10.99.0."
