# runner - a single throwaway VM for the deployment-tier smokes that need a REAL
# installed, systemd-run, SELinux-enforcing system (which a rootless toolbox can't
# provide). One node on mgmt; the component rpm(s) + the in-VM check script come
# from the caller (RUNNER_RPMS / RUNNER_CHECK / RUNNER_ENV). Driven by runner.sh.
NODES=( "runner:host" )
