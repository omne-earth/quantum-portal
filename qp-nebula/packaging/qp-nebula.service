[Unit]
Description=Post-Quantum overlay mesh daemon (qp-nebula)
# nebula needs the underlay network up to bind :4242 and reach the lighthouse.
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/qp/sbin/qp-nebula -config /usr/local/qp/etc/nebula/config.yml
User=qp-nebula
Group=qp-nebula
Restart=always
RestartSec=5

# Local control socket for `nebula ctl`: systemd creates /run/nebula (0750, owned by
# the service user) before ExecStart and reaps it on stop. The socket itself is 0660,
# group qp-nebula - clients reach it by group membership; remote admin forwards it
# over qp-ssh.
RuntimeDirectory=nebula
RuntimeDirectoryMode=0750

# Defense in depth - mirror the qp_nebula_t SELinux domain. Exactly ONE capability:
# create/raise the tun, assign the overlay addr, install routes (rtnetlink). No setuid
# privsep, so NoNewPrivileges is safe (ambient CAP_NET_ADMIN survives it).
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes

# The tun device: PrivateDevices=yes would HIDE /dev/net/tun, so use a closed device
# policy that exposes only the standard pseudo-devices plus tun.
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
# nebula loads no modules; the kernel autoloads tun.ko on /dev/net/tun open. If a
# minimal host lacks tun, `modprobe tun` once (or drop this line).
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_INET/INET6 for the UDP underlay + overlay; AF_NETLINK for rtnetlink route/addr
# ops; AF_UNIX for the local control socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
# Go (CGO_ENABLED=0, no plugins) runs fine under W^X.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
